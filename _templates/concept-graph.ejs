<%
// Concept graph: a hierarchy laid out at render time as a static SVG.
//   Tab (Machine Learning, Math, Data, System) → Topic (a course folder, labelled by the page
//   subtitle, e.g. "Calculus") → Lecture. Only published pages.
// Labels are hidden until a node is hovered or focused; then the node, all its ancestors and
// its direct children show their labels and the rest dims. That reveal is plain CSS (:has
// rules generated below). Touch screens (no hover) show every label.
// A small inline script lets visitors drag nodes (the owner-approved exception; see CLAUDE.md).
const params = (typeof templateParams !== 'undefined' && templateParams) || {};
const ROOT = params.root || '';
const DOMAINS = { ml: 'Machine Learning', math: 'Math', data: 'Data', system: 'System' };
const DOMAIN_ORDER = Object.keys(DOMAINS);
const norm = (p) => String(p || '').replace(/\\/g, '/').replace(/^\/+/, '');
const pageHref = (item) => ROOT + norm(item.outputHref || item.path).replace(/\.qmd$/, '.html');
const asList = (v) => (Array.isArray(v) ? v : v ? [v] : []).map((t) => String(t).trim()).filter(Boolean);
const topicLabelOf = (item) => String(item.subtitle || '').split('·')[0].trim() || asList(item.categories)[0] || '';

// ---- Build the hierarchy ----
const nodes = [];
const add = (n) => { n.id = nodes.length; n.parents = []; n.children = []; nodes.push(n); return n; };
const link = (parent, child) => { if (!child.parents.includes(parent)) { child.parents.push(parent); parent.children.push(child); } };
const domainNode = {};
const topicNode = {};
const pageNodes = [];
items
  .map((item) => ({ item, parts: norm(item.path).split('/') }))
  // Quarto listings include `draft: true` pages; only published pages belong in the graph
  .filter(({ item, parts }) => DOMAINS[parts[0]] && !item.draft && item.kind !== 'index' && parts[parts.length - 1] !== 'index.qmd')
  .sort((a, b) => DOMAIN_ORDER.indexOf(a.parts[0]) - DOMAIN_ORDER.indexOf(b.parts[0]) || String(a.item.title).localeCompare(String(b.item.title)))
  .forEach(({ item, parts }) => {
    const d = parts[0];
    const tl = topicLabelOf(item);
    domainNode[d] = domainNode[d] || add({ kind: 'domain', domain: d, label: DOMAINS[d], href: ROOT + d + '/index.html' });
    let parent = domainNode[d];
    if (parts.length > 2) {
      const tk = d + '/' + parts[1];
      topicNode[tk] = topicNode[tk] || add({ kind: 'topic', domain: d, label: tl || parts[1], href: ROOT + tk + '/index.html' });
      link(domainNode[d], topicNode[tk]);
      parent = topicNode[tk];
    }
    const page = add({ kind: 'page', domain: d, label: item.title, href: pageHref(item) });
    link(parent, page);
    pageNodes.push(page);
  });

const edges = [];
for (const n of nodes) for (const ch of n.children) edges.push([n, ch]);
const ancestors = (n, acc = new Set()) => { for (const p of n.parents) if (!acc.has(p)) { acc.add(p); ancestors(p, acc); } return acc; };

// ---- Geometry per kind ----
const DOT = { domain: 9, topic: 6, page: 5 };
const CH = { domain: 7.7, topic: 6.9, page: 6.9 };
const LINE = { domain: 20, topic: 17, page: 16 };
// Long page titles break into two balanced lines
const linesOf = (n) => {
  if (n.kind !== 'page' || n.label.length <= 24) return [n.label];
  const words = n.label.split(' ');
  let best = [n.label], longest = n.label.length;
  for (let i = 1; i < words.length; i++) {
    const two = [words.slice(0, i).join(' '), words.slice(i).join(' ')];
    const len = Math.max(two[0].length, two[1].length);
    if (len < longest) { best = two; longest = len; }
  }
  return best;
};
const boxOf = (n) => {
  const ls = linesOf(n), w = Math.max(...ls.map((l) => l.length)) * CH[n.kind] + 8, h = LINE[n.kind] * ls.length;
  return { x: n.x - w / 2, y: n.below ? n.y + DOT[n.kind] + 4 : n.y - DOT[n.kind] - 6 - h, w, h };
};
// Where a label's text sits inside its box: its centre, and one baseline per line
const textOf = (n) => {
  const b = boxOf(n);
  return { x: b.x + b.w / 2, lines: linesOf(n).map((text, i) => ({ text, y: b.y + LINE[n.kind] * (i + 1) - LINE[n.kind] * 0.28 })) };
};
const dotBox = (n, pad = 4) => { const r = DOT[n.kind] + pad; return { x: n.x - r, y: n.y - r, w: r * 2, h: r * 2 }; };
// A label keeps this much clear space around every other dot, so it reads as its own dot's
const LABEL_CLEAR = 16;
const RANK = { domain: 3, topic: 2, page: 1 };

// ---- Deterministic force layout, each domain held at a stable anchor ----
// One domain sits centred, two side by side, three or four in a 2 x 2 grid (ML and Math
// above, Data and System below). Domain nodes are pinned to their anchors.
const K = 95;
const WEIGHT = { domain: 1.6, topic: 1.1, page: 0.8 };
const GX = 1.4, GY = 1.6;
const present = DOMAIN_ORDER.filter((d) => domainNode[d]);
const most = Math.max(1, ...present.map((d) => pageNodes.filter((p) => p.domain === d).length));
const SX = K * 0.75 * Math.sqrt(most), SY = K * 0.65 * Math.sqrt(most);
const anchor = {};
present.forEach((d, i) => {
  if (present.length === 1) anchor[d] = { x: 0, y: 0 };
  else if (present.length === 2) anchor[d] = { x: (i - 0.5) * 2 * SX, y: 0 };
  else anchor[d] = { x: ((i % 2) - 0.5) * 2 * SX, y: (Math.floor(i / 2) - 0.5) * 2 * SY };
});
const anchorOf = (n) => anchor[n.domain];
// Seed: each node starts on a ring around its first parent, children spread evenly
for (const d of present) { domainNode[d].x = anchor[d].x; domainNode[d].y = anchor[d].y; }
const seedChildren = (n, depth) => {
  const fresh = n.children.filter((c) => c.x === undefined);
  fresh.forEach((c, j) => {
    const a = (j / fresh.length) * Math.PI * 2 + depth * 0.7;
    c.x = n.x + Math.cos(a) * K; c.y = n.y + Math.sin(a) * K;
  });
  for (const c of fresh) seedChildren(c, depth + 1);
};
for (const d of present) seedChildren(domainNode[d], 0);
const ITER = nodes.length > 400 ? 120 : 360;
for (let it = 0; it < ITER; it++) {
  const temp = 40 * (1 - it / ITER) + 0.5;
  for (const n of nodes) { n.dx = 0; n.dy = 0; }
  for (let i = 0; i < nodes.length; i++) for (let j = i + 1; j < nodes.length; j++) {
    const a = nodes[i], b = nodes[j];
    let dx = a.x - b.x, dy = a.y - b.y; const d = Math.hypot(dx, dy) || 0.01;
    const f = (K * K * WEIGHT[a.kind] * WEIGHT[b.kind]) / d;
    dx /= d; dy /= d; a.dx += dx * f; a.dy += dy * f; b.dx -= dx * f; b.dy -= dy * f;
  }
  for (const [a, b] of edges) {
    let dx = a.x - b.x, dy = a.y - b.y; const d = Math.hypot(dx, dy) || 0.01;
    const f = (d * d) / K;
    dx /= d; dy /= d; a.dx -= dx * f; a.dy -= dy * f; b.dx += dx * f; b.dy += dy * f;
  }
  for (const n of nodes) {
    if (n.kind === 'domain') continue;
    const an = anchorOf(n);
    n.dx -= (n.x - an.x) * GX; n.dy -= (n.y - an.y) * GY;
    const m = Math.hypot(n.dx, n.dy) || 1;
    n.x += (n.dx / m) * Math.min(m, temp); n.y += (n.dy / m) * Math.min(m, temp);
  }
}
// A label sits on the side away from the node's lines: below the dot when they leave upwards
for (const n of nodes) n.below = [...n.parents, ...n.children].reduce((s, m) => s + m.y - n.y, 0) < 0;
// ---- No two labels or dots overlap; higher levels hold their place ----
const overlap = (a, b) => ({ x: Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x), y: Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y) });
const clash = (a, b) => { const o = overlap(a, b); return o.x > 0 && o.y > 0; };
const separate = () => {
  let moved = false;
  for (let i = 0; i < nodes.length; i++) for (let j = 0; j < nodes.length; j++) {
    if (i === j) continue;
    const a = nodes[i], b = nodes[j];
    for (const [ra, rb] of [[boxOf(a), boxOf(b)], [boxOf(a), dotBox(b, LABEL_CLEAR)], [dotBox(a), dotBox(b)]]) {
      const o = overlap(ra, rb);
      if (o.x <= 0 || o.y <= 0) continue;
      moved = true;
      // The lower level moves the whole distance; equal levels split it; domains never move
      let wa = RANK[a.kind] === RANK[b.kind] ? 0.5 : RANK[a.kind] < RANK[b.kind] ? 1 : 0;
      if (a.kind === 'domain') wa = 0;
      if (b.kind === 'domain') wa = a.kind === 'domain' ? 0 : 1;
      if (o.x < o.y) { const s = (ra.x < rb.x ? -1 : 1) * (o.x + 2); a.x += s * wa; if (b.kind !== 'domain') b.x -= s * (1 - wa); }
      else { const s = (ra.y < rb.y ? -1 : 1) * (o.y + 2); a.y += s * wa; if (b.kind !== 'domain') b.y -= s * (1 - wa); }
    }
  }
  return moved;
};
for (let it = 0; it < 300 && separate(); it++);
// No line skims a dot it does not join: nudge the dot (or, for a pinned domain, the line's
// lower end) aside, then settle overlaps again
const SKIM = 16;
const skims = () => {
  let moved = false;
  for (const [u, v] of edges) for (const n of nodes) {
    if (n === u || n === v) continue;
    const vx = v.x - u.x, vy = v.y - u.y, len2 = vx * vx + vy * vy || 1;
    const t = ((n.x - u.x) * vx + (n.y - u.y) * vy) / len2;
    if (t <= 0 || t >= 1) continue;
    const dx = n.x - (u.x + vx * t), dy = n.y - (u.y + vy * t), d = Math.hypot(dx, dy);
    const need = DOT[n.kind] + SKIM;
    if (d >= need) continue;
    const ux = d > 0.5 ? dx / d : -vy / Math.sqrt(len2), uy = d > 0.5 ? dy / d : vx / Math.sqrt(len2);
    const step = (need - d) / 2 + 1;
    if (n.kind === 'domain' || RANK[n.kind] > RANK[v.kind]) { v.x -= ux * step; v.y -= uy * step; }
    else { n.x += ux * step; n.y += uy * step; }
    moved = true;
  }
  return moved;
};
for (let it = 0; it < 60; it++) { const a = skims(), b = separate(); if (!a && !b) break; }
// Last resort for a lecture that still collides, or whose lines touch another dot: search
// outwards (rings to 240px) for the closest spot that is clear of both
const LABEL_HIT = 1e6, LINE_HIT = 1e4;
const hits = (n) => nodes.reduce((c, m) => c + (m !== n && (clash(boxOf(n), boxOf(m)) || clash(boxOf(n), dotBox(m, LABEL_CLEAR)) || clash(dotBox(n, LABEL_CLEAR), boxOf(m)) || clash(dotBox(n), dotBox(m))) ? 1 : 0), 0);
const touches = (u, v, n) => {
  if (n === u || n === v) return false;
  const vx = v.x - u.x, vy = v.y - u.y, t = ((n.x - u.x) * vx + (n.y - u.y) * vy) / (vx * vx + vy * vy || 1);
  return t > 0 && t < 1 && Math.hypot(n.x - u.x - vx * t, n.y - u.y - vy * t) < DOT[n.kind] + 5;
};
const lineHits = (c) => edges.reduce((s, [u, v]) => s + (u === c || v === c ? nodes.filter((n) => touches(u, v, n)).length : touches(u, v, c) ? 1 : 0), 0);
const cost = (c) => hits(c) * LABEL_HIT + lineHits(c) * LINE_HIT;
for (let pass = 0; pass < 3; pass++) for (const c of nodes.filter((n) => n.kind === 'page')) {
  if (!cost(c)) continue;
  const home = { x: c.x, y: c.y };
  let best = { ...home, score: cost(c) };
  for (let r = 0; r <= 240; r += 20) for (let k = 0; k < (r ? 16 : 1); k++) {
    const a = (k / 16) * Math.PI * 2;
    c.x = home.x + Math.cos(a) * r; c.y = home.y + Math.sin(a) * r;
    const score = cost(c) + r;
    if (score < best.score) best = { x: c.x, y: c.y, score };
  }
  c.x = best.x; c.y = best.y;
}

// ---- Hover reveal: node H shows itself, all its ancestors and its direct children ----
for (const n of nodes) n.shownBy = new Set([n.id]);
for (const h of nodes) {
  for (const a of ancestors(h)) a.shownBy.add(h.id);
  for (const c of h.children) c.shownBy.add(h.id);
}
const edgeShownBy = ([u, v]) => nodes.filter((h) => v === h || u === h || (ancestors(h).has(v) && ancestors(h).has(u))).map((h) => h.id);
const cls = (ids) => [...ids].map((i) => 'r' + i).join(' ');


// ---- Fit the viewBox; the page decides how far it may scale (Home: up to 1.1x) ----
let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
for (const n of nodes) for (const r of [boxOf(n), dotBox(n)]) {
  x0 = Math.min(x0, r.x); y0 = Math.min(y0, r.y); x1 = Math.max(x1, r.x + r.w); y1 = Math.max(y1, r.y + r.h);
}
const PAD = 16;
const W = Math.ceil(x1 - x0 + PAD * 2), H = Math.ceil(y1 - y0 + PAD * 2);
const X = (v) => (v - x0 + PAD).toFixed(1), Y = (v) => (v - y0 + PAD).toFixed(1);
// Below 80% of natural size labels would drop under about 11px: show the list instead
const LIST_BELOW = Math.ceil(W * 0.8);
const count = (k) => nodes.filter((n) => n.kind === k).length;
const plural = (n, w) => n + ' ' + w + (n === 1 ? '' : 's');
const summary = [plural(count('domain'), 'tab'), plural(count('topic'), 'topic'), plural(count('page'), 'lecture')].join(', ');
const NAME = { domain: (n) => n.label + ', tab', topic: (n) => n.label + ', topic', page: (n) => n.label };
const order = ['domain', 'topic', 'page'];
%>
<% if (pageNodes.length) { %>
<figure class="concept-graph">
<style>
@container concept-graph (max-width: <%= LIST_BELOW %>px) { .concept-graph-frame { display: none; } .cg-list { display: block; } }
<% for (const h of nodes) { %>.concept-graph svg:has(.n<%= h.id %> > a:hover, .n<%= h.id %> > a:focus-visible) .r<%= h.id %> { opacity: 1; } .concept-graph svg:has(.n<%= h.id %> > a:hover, .n<%= h.id %> > a:focus-visible) .r<%= h.id %> .cg-label { visibility: visible; } .concept-graph svg:has(.n<%= h.id %> > a:hover, .n<%= h.id %> > a:focus-visible) .l<%= h.id %> text { fill: var(--cg-trace); text-decoration: underline; }
<% } %></style>
<div class="cg-head"><ul class="cg-key" aria-label="Domains"><% for (const d of present) { %><li class="domain-<%= d %>"><%= DOMAINS[d] %></li><% } %></ul></div>
<a class="cg-skip visually-hidden-focusable" href="#concept-graph-end">Skip the concept graph</a>
<div class="concept-graph-frame">
<svg viewBox="0 0 <%= W %> <%= H %>" style="--w: <%= W %>px" role="group" aria-label="Concept graph: <%= summary %>">
<g class="cg-edges" aria-hidden="true"><% for (const e of edges) { const [u, v] = e; %><line class="<%= cls(edgeShownBy(e)) %>" data-a="<%= u.id %>" data-b="<%= v.id %>" x1="<%= X(u.x) %>" y1="<%= Y(u.y) %>" x2="<%= X(v.x) %>" y2="<%= Y(v.y) %>"/><% } %></g>
<% for (const kind of order) { %><g class="cg-<%= kind %>s"><% for (const n of nodes.filter((m) => m.kind === kind)) { %><g class="cg-node cg-<%= kind %> domain-<%= n.domain %> n<%= n.id %> <%= cls(n.shownBy) %>" data-id="<%= n.id %>"><a href="<%= n.href %>" aria-label="<%= NAME[kind](n) %>"><circle class="cg-hit" cx="<%= X(n.x) %>" cy="<%= Y(n.y) %>" r="<%= DOT[kind] + 7 %>"/><circle class="cg-dot" cx="<%= X(n.x) %>" cy="<%= Y(n.y) %>" r="<%= DOT[kind] %>"/></a></g><% } %></g><% } %>
<g class="cg-labels" aria-hidden="true"><% for (const n of nodes) { const b = boxOf(n); %><g class="cg-label-node cg-<%= n.kind %> domain-<%= n.domain %> l<%= n.id %> <%= cls(n.shownBy) %>" data-id="<%= n.id %>"><g class="cg-label"><rect x="<%= X(b.x) %>" y="<%= Y(b.y) %>" width="<%= b.w.toFixed(1) %>" height="<%= b.h %>"/><% const tx = textOf(n); %><text text-anchor="middle"><% for (const l of tx.lines) { %><tspan x="<%= X(tx.x) %>" y="<%= Y(l.y) %>"><%= l.text %></tspan><% } %></text></g></g><% } %></g>
</svg>
</div>
<ul class="cg-list"><% for (const p of pageNodes) { const t = p.parents[0]; %><li class="domain-<%= p.domain %>"><a class="cg-list-page" href="<%= p.href %>"><%= p.label %></a><span class="cg-list-terms"><span class="cg-list-domain"><%= DOMAINS[p.domain] %><% if (t.kind === 'topic') { %> · <%= t.label %><% } %></span></span></li><% } %></ul>
<span id="concept-graph-end"></span>
<script>
// Node dragging (progressive enhancement; without it the graph is a fixed static figure).
// No JS template literals here: Quarto renders this file with lodash, which treats
// dollar-brace placeholders as its own interpolation.
// Grab a node to move it: its label moves with it and its edges stay attached. A click
// without a drag still follows the node's link. A reload restores the layout.
(() => {
  const fig = document.currentScript.closest('figure');
  const svg = fig && fig.querySelector('.concept-graph-frame svg');
  if (!svg) return;
  const [, , W, H] = svg.getAttribute('viewBox').split(/[\s,]+/).map(Number);
  const DRAG_PX = 4;
  const nodes = new Map(); // id -> { els, cx, cy, dx, dy }; els = the node's dot group and label group
  for (const g of svg.querySelectorAll('.cg-node[data-id]')) {
    const dot = g.querySelector('.cg-dot');
    const els = [...svg.querySelectorAll('[data-id="' + g.dataset.id + '"]')].filter((el) => !el.matches('line'));
    nodes.set(g.dataset.id, { els, cx: +dot.getAttribute('cx'), cy: +dot.getAttribute('cy'), dx: 0, dy: 0 });
  }
  const lines = [...svg.querySelectorAll('.cg-edges line[data-a]')].map((l) => ({
    l, a: l.dataset.a, b: l.dataset.b,
    x1: +l.getAttribute('x1'), y1: +l.getAttribute('y1'), x2: +l.getAttribute('x2'), y2: +l.getAttribute('y2'),
  }));
  const place = (id) => {
    const n = nodes.get(id);
    const tf = n.dx || n.dy ? 'translate(' + n.dx.toFixed(1) + ' ' + n.dy.toFixed(1) + ')' : '';
    for (const el of n.els) el.setAttribute('transform', tf);
    for (const e of lines) {
      if (e.a === id) { e.l.setAttribute('x1', (e.x1 + n.dx).toFixed(1)); e.l.setAttribute('y1', (e.y1 + n.dy).toFixed(1)); }
      if (e.b === id) { e.l.setAttribute('x2', (e.x2 + n.dx).toFixed(1)); e.l.setAttribute('y2', (e.y2 + n.dy).toFixed(1)); }
    }
  };

  // Drag a node; pointer capture starts only once the pointer has really moved
  let drag = null;
  svg.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    const g = e.target.closest('.cg-node[data-id]');
    if (!g) return;
    const n = nodes.get(g.dataset.id);
    drag = { id: g.dataset.id, pid: e.pointerId, sx: e.clientX, sy: e.clientY, ox: n.dx, oy: n.dy, moving: false };
  });
  svg.addEventListener('pointermove', (e) => {
    if (!drag || e.pointerId !== drag.pid) return;
    if (!drag.moving) {
      if (Math.hypot(e.clientX - drag.sx, e.clientY - drag.sy) < DRAG_PX) return;
      drag.moving = true;
      svg.setPointerCapture(e.pointerId);
      svg.classList.add('is-dragging');
    }
    const r = svg.getBoundingClientRect();
    const k = W / r.width; // screen px -> SVG units
    const n = nodes.get(drag.id);
    // Keep the dot inside the figure
    n.dx = Math.min(Math.max(drag.ox + (e.clientX - drag.sx) * k, -n.cx), W - n.cx);
    n.dy = Math.min(Math.max(drag.oy + (e.clientY - drag.sy) * k, -n.cy), H - n.cy);
    place(drag.id);
  });
  const end = (e) => {
    if (!drag || e.pointerId !== drag.pid) return;
    if (drag.moving) {
      svg.classList.remove('is-dragging');
      // Swallow the click that may follow a drag so it does not open the link; disarm right
      // after, so a drag that produced no click never eats the next real one
      const swallow = (c) => { c.preventDefault(); c.stopPropagation(); };
      svg.addEventListener('click', swallow, { capture: true, once: true });
      setTimeout(() => svg.removeEventListener('click', swallow, { capture: true }), 0);
    }
    drag = null;
  };
  svg.addEventListener('pointerup', end);
  svg.addEventListener('pointercancel', end);
  svg.addEventListener('dragstart', (e) => e.preventDefault());
  svg.classList.add('is-draggable');

  // Quarto's link-external-newwindow reads an SVG link's href as an object, so it marks every
  // node as external (new tab). These links are internal: undo that once Quarto has run.
  const unmark = () => svg.querySelectorAll('a[target]').forEach((a) => {
    a.removeAttribute('target'); a.removeAttribute('rel'); a.removeAttribute('aria-describedby');
  });
  document.addEventListener('DOMContentLoaded', unmark);
  window.addEventListener('load', unmark);
})();
</script>
</figure>
<% } %>
