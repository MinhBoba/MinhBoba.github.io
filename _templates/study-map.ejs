<%
// Study map figure, generated from page headers (no hand edits).
// Course: <domain>/<folder>/index.qmd with `course: true` and `lectures-total: N`.
// Lecture: any other .qmd in a course folder. Its slot comes from `lecture: N`,
// else "Lecture N" in the subtitle, else "lectureNN" in the file name.
// A lecture with `status: in progress` draws dotted; published lectures solid; the rest dashed.
// template-params: domain (draw one lane only), figure (number label), caption (override).
const params = (typeof templateParams !== 'undefined' && templateParams) || {};
const ALL = [
{ key: 'ml', label: 'Machine Learning' },
{ key: 'math', label: 'Math' },
{ key: 'data', label: 'Data' },
{ key: 'system', label: 'System' },
];
const DOMAINS = params.domain ? ALL.filter((d) => d.key === params.domain) : ALL;
const ROOT = params.domain ? '../' : '';
const EXTRA = new Set(['notes', 'dsa', 'problems', 'reports', 'case-studies', 'applications']);
const norm = (p) => String(p || '').replace(/\\/g, '/').replace(/^\/+/, '');
const href = (item) => ROOT + norm(item.outputHref || item.path).replace(/\.qmd$/, '.html');
const shortName = (t) => String(t || '').split(':')[0].replace(/^Stanford\s+/i, '').trim();
const fmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const lectureNo = (item, file) => {
const n = Number(item.lecture);
if (n > 0) return n;
const m = String(item.subtitle || '').match(/lecture\s*(\d+)/i) || String(file).match(/lecture[-_ ]?0*(\d+)/i);
return m ? Number(m[1]) : null;
};
const courses = {};
const lanes = {};
for (const d of ALL) lanes[d.key] = { latest: null };
for (const item of items) {
const parts = norm(item.path).split('/');
const domain = parts[0];
if (!lanes[domain] || parts.length < 3) continue;
const folder = parts[1];
const file = parts[parts.length - 1];
if (EXTRA.has(folder)) continue;
const key = domain + '/' + folder;
courses[key] = courses[key] || { domain, item: null, lectures: [] };
if (file === 'index.qmd') { if (item.course) courses[key].item = item; continue; }
courses[key].lectures.push({ item, n: lectureNo(item, file) });
if (!lanes[domain].latest || new Date(item.date || 0) > new Date(lanes[domain].latest.date || 0)) lanes[domain].latest = item;
}
const list = Object.values(courses).filter((c) => c.item);
for (const c of list) {
c.total = Math.max(Number(c.item['lectures-total']) || 0, ...c.lectures.map((l) => l.n || 0), c.lectures.length);
c.slots = Array.from({ length: c.total }, () => null);
const unplaced = [];
for (const l of c.lectures) { if (l.n && l.n <= c.total && !c.slots[l.n - 1]) c.slots[l.n - 1] = l; else unplaced.push(l); }
for (const l of unplaced) { const i = c.slots.indexOf(null); if (i >= 0) c.slots[i] = l; }
}
const AXIS = Math.max(20, ...list.map((c) => c.total));
const marks = [1, 5, 10, 15, 20, 25, 30, 35, 40].filter((m) => m <= AXIS);
const figure = params.figure || '1';
%>
<figure class="study-map" aria-labelledby="study-map-caption-<%= figure %>">
<div class="study-axis" aria-hidden="true"><span class="study-axis-title">Lecture</span><span class="study-axis-scale"><% for (const m of marks) { %><span class="study-axis-mark" style="left: <%= ((m - 0.5) / AXIS * 100).toFixed(3) %>%"><%= m %></span><% } %></span></div>
<% for (const d of DOMAINS) { const lane = lanes[d.key]; const laneCourses = list.filter((c) => c.domain === d.key); %>
<div class="study-lane domain-<%= d.key %>">
<a class="study-lane-label" href="<%= ROOT %><%= d.key %>/index.html"><%= d.label %></a>
<div class="study-lane-courses">
<% if (laneCourses.length === 0) { %>
<div class="study-course is-empty"><span class="study-course-name" aria-hidden="true"></span><span class="study-segment is-empty" style="--span: 100%"><span class="study-empty-label">Planned</span></span></div>
<% } %>
<% for (const c of laneCourses) { const name = shortName(c.item.title); %>
<div class="study-course"><a class="study-course-name" href="<%= href(c.item) %>"><%= name %></a><span class="study-segment" style="--span: <%= (c.total / AXIS * 100).toFixed(3) %>%; --n: <%= c.total %>" role="list" aria-label="<%= name %>, <%= c.lectures.length %> of <%= c.total %> lectures"><% c.slots.forEach((s, i) => { if (s) { const prog = String(s.item.status || '').toLowerCase() === 'in progress'; %><a role="listitem" class="slot <%= prog ? 'is-progress' : 'is-published' %>" href="<%= href(s.item) %>" title="Lecture <%= i + 1 %>: <%= s.item.title %>" aria-label="Lecture <%= i + 1 %>: <%= s.item.title %><%= prog ? ' (in progress)' : '' %>"></a><% } else { %><span class="slot is-planned" aria-hidden="true"></span><% } }) %></span></div>
<% } %>
</div>
<p class="study-lane-note<%= laneCourses.length ? '' : ' is-empty' %>"><% if (laneCourses.length) { const done = laneCourses.reduce((a, c) => a + c.lectures.length, 0); const all = laneCourses.reduce((a, c) => a + c.total, 0); %><%= done %> of <%= all %> lectures<% if (lane.latest) { %><span class="study-latest">Latest: <a href="<%= href(lane.latest) %>"<% if (lane.latest.date) { %> title="<%= fmt(lane.latest.date) %>"<% } %>><%= lane.latest.title %></a></span><% } %><% } %></p>
</div>
<% } %>
<div class="study-legend" aria-hidden="true"><span><i class="slot is-published"></i>Written up</span><span><i class="slot is-progress"></i>In progress</span><span><i class="slot is-planned"></i>Planned</span></div>
<figcaption id="study-map-caption-<%= figure %>"><strong>Figure <%= figure %>.</strong> <%= params.caption || 'Study map. Each row is a domain and each bar a course, drawn to its real number of lectures; select a filled slot to open that lecture.' %></figcaption>
</figure>
